# Vendor-neutral editor baseline; editor-specific folders (.vscode, .idea) are untracked.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf
